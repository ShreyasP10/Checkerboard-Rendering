# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.cpp text eol=lf
*.h text eol=lf
*.comp text eol=lf
*.hlsl text eol=lf
*.md text eol=lf
*.ini text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Binary files
*.spv binary
*.dxil binary
*.dll binary
*.exe binary
*.lib binary
*.png binary
*.jpg binary
